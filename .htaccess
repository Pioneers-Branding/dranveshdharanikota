# Dr. Anvesh Dharanikota - site server configuration (Apache / LiteSpeed)
#
# URL policy: every page keeps the exact address it had on the React site, with
# no trailing slash and no file extension. Each page is one .php file named
# after its route, and that file is served internally, so /services/gi-thoracic
# answers 200 from services/gi-thoracic.php rather than redirecting anywhere.
#
# The host must run PHP. Any ordinary shared host does, Hostinger included.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # mod_dir would otherwise 301 /x to /x/ and change every indexed URL.
  DirectorySlash Off

  # Canonical host: https, no www. Matches the canonical tags the pages carry.
  # Both conditions must fail before redirecting: on hosts that terminate TLS
  # at a proxy, %{HTTPS} is off even for HTTPS requests, and checking it alone
  # would redirect forever. Delete this block if the host already forces HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /path/ -> /path
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # The four rules below match on THE_REQUEST, the literal request line the
  # browser sent, rather than on the current URI. In .htaccess context Apache
  # re-runs this ruleset after the internal rewrite at the bottom, and matching
  # the rewritten URI would bounce /path straight back forever.

  # /index.php -> /
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  # /path.php -> /path
  RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
  RewriteRule ^(.+)\.php$ /$1 [R=301,L]

  # Addresses this site used before it was PHP, kept so old links and anything
  # still in Google's index land on the right page instead of a 404.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)(/index)?\.html[\s?] [NC]
  RewriteRule ^(.+?)(/index)?\.html$ /$1 [R=301,L]

  # Serve <route>.php for the clean URL without redirecting.
  #
  # The second condition keeps directories that hold no page of their own,
  # /css and /photos among them, from rewriting to a file that does not exist.
  # There is deliberately no !-d guard: /services and /techniques ARE
  # directories and still have to resolve to services.php and techniques.php.
  #
  # This tests %{REQUEST_FILENAME}, the path the server already worked out for
  # the request, rather than building one from %{DOCUMENT_ROOT}. The two are
  # the same on a plain domain-root install, but DOCUMENT_ROOT is wrong
  # whenever the site sits in a subfolder or the host points the domain
  # somewhere other than the account root, and when it is wrong this condition
  # silently fails and every page 404s while the homepage still works.
  # The substitution is relative for the same reason.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php

# The shared includes are pulled in by the page files and are never a page of
# their own. Refuse them if anyone asks for one directly.
#
# Both spellings are wrapped, so on a server that has neither module this block
# does nothing rather than failing the whole site with a 500.
<FilesMatch "^(header|footer|header-include|icons|router)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
