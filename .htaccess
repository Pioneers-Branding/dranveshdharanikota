# Dr. Anvesh Dharanikota - static site server configuration (Apache / LiteSpeed)
#
# URL policy: every page keeps the exact address it had on the React site, with
# no trailing slash and no .html suffix. Each page is one file named after its
# route, and that file is served internally, so /services/gi-thoracic answers
# 200 from services/gi-thoracic.html rather than redirecting anywhere.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # mod_dir would otherwise 301 /x to /x/ and change every indexed URL.
  DirectorySlash Off

  # Canonical host: https, no www. Matches the canonical tags the pages carry.
  # Both conditions must fail before redirecting: on hosts that terminate TLS
  # at a proxy, %{HTTPS} is off even for HTTPS requests, and checking it alone
  # would redirect forever. Delete this block if the host already forces HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /path/ -> /path
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # /index.html -> /
  #
  # This and the two rules under it match on THE_REQUEST, the literal request
  # line the browser sent, rather than on the current URI. In .htaccess context
  # Apache re-runs this ruleset after the internal rewrite at the bottom, and
  # matching the rewritten URI would bounce /path straight back forever.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # /path/index.html -> /path. Kept because pages used to live at that address
  # before each route became a single file; anything still linking there lands
  # on the right page instead of a 404.
  RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
  RewriteRule ^(.+)/index\.html$ /$1 [R=301,L]

  # /path.html -> /path. 404.html is exempt so ErrorDocument can serve it.
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Serve <route>.html for the clean URL without redirecting.
  # The second condition keeps directories that hold no page of their own,
  # /css and /photos among them, from rewriting to a file that does not exist.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
