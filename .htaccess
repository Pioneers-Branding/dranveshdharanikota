# Dr. Anvesh Dharanikota - site server configuration
#
# URL policy: every page keeps the exact address it had on the React site, with
# no trailing slash and no .php on the end. Each page is one .php file named
# after its route, and that file is served internally, so /services/gi-thoracic
# answers 200 from services/gi-thoracic.php without redirecting anywhere.
#
# The host must run PHP. Any ordinary shared host does.
#
# ---------------------------------------------------------------------------
# Note on how this file is laid out
#
# The rewrite rules below sit at the top level, NOT inside <IfModule>. That is
# deliberate. Apache reads them either way, but OpenLiteSpeed, which is what
# CyberPanel installs, has only partial .htaccess support: it looks for rewrite
# directives and ignores the rest, and directives buried inside a container it
# does not handle can be skipped entirely. Keeping them unwrapped and first is
# the arrangement most likely to be read by whatever is serving the site.
#
# Everything after the rewrite section is Apache-only and stays wrapped, so a
# server that does not support those directives skips them harmlessly.
#
# If NOTHING in this file appears to take effect, the server is not reading it
# at all. That is a server setting, not a mistake in this file. See
# rewrite-rules.txt for the fix.
# ---------------------------------------------------------------------------

RewriteEngine On

# Canonical host: https, no www, matching the canonical tags the pages carry.
# Both conditions must fail before redirecting: on a host that terminates TLS
# at a proxy %{HTTPS} reads as off even for an https request, and testing it
# alone would redirect forever. Local HTTP development hosts are excluded so
# XAMPP/WAMP and `php -S` do not get sent to an HTTPS port that does not exist.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# /path/ -> /path
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.*)/$ /$1 [R=301,L]

# The next four rules test THE_REQUEST, the literal request line the browser
# sent, rather than the current address. This ruleset runs again after the
# internal rewrite further down, and testing the rewritten address would send
# /contact back and forth forever.

# /index.php -> /
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# /contact.php -> /contact, so the extension never shows in the address bar
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Addresses this site used before it was PHP, kept so old links and anything
# still in Google's index land on the right page instead of an error.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)(/index)?\.html[\s?] [NC]
RewriteRule ^(.+?)(/index)?\.html$ /$1 [R=301,L]

# 301 Redirects for SEO updated URLs
RewriteRule ^services/breast-oncoplastic/?$ /services/breast-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/esophageal-cancer/?$ /services/esophageal-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/gastric-cancer/?$ /services/stomach-gastric-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/colorectal-cancer/?$ /services/colorectal-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/hpb/?$ /services/hpb-liver-pancreatic-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/lung-cancer/?$ /services/lung-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/gynecologic-oncology/?$ /services/gynecologic-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/head-neck-oncology/?$ /services/head-neck-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/uro-oncology/?$ /services/urological-cancer-treatment-hyderabad [R=301,L]
RewriteRule ^services/musculoskeletal-oncology/?$ /services/bone-cancer-treatment-hyderabad [R=301,L]

# Always resolve the homepage through PHP. DirectoryIndex normally does this,
# but an explicit rule also works on LiteSpeed configurations that do not load
# the mod_dir compatibility layer.
RewriteRule ^$ index.php [L]

# The shared includes are not pages. Without this, the clean-URL rule below
# would happily serve header.php for /header. They also refuse a direct request
# in PHP, but that guard cannot fire on a server that hands the request to a
# different script, so block the address here as well.
RewriteRule ^(header|footer|header-include|icons|router)/?$ /404.php [L]

# The rule that matters: serve <route>.php for the clean URL, without
# redirecting, so /contact stays /contact in the address bar.
#
# Handle pages below the real services and techniques directories first. On
# OpenLiteSpeed, REQUEST_FILENAME can still be unresolved while a request is
# being rewritten below an existing directory, so the generic -f check below
# may never see services/foo.php even when that file exists.
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteRule ^(services|techniques)/([^/]+)/?$ $1/$2.php [L]

# There is deliberately no !-d guard: /services and /techniques are real
# directories that still have to resolve to services.php and techniques.php.
# Only the existing-file check is needed. Testing REQUEST_FILENAME.php with a
# second filesystem condition looks sensible, but several LiteSpeed builds do
# not resolve that constructed path consistently. The URI guard prevents the
# internal rewrite from appending .php again on its second pass; the real-file
# check keeps css, js and photos untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteRule ^(.+?)/?$ $1.php [L]

# Anything left over is a genuine miss, so hand it to the site's own 404 page.
#
# This is here because OpenLiteSpeed ignores ErrorDocument in .htaccess, which
# is why a wrong address showed the grey LiteSpeed error page instead of the
# site's. Reaching 404.php by rewrite would normally answer 200, so 404.php
# sends the 404 status itself.
#
# ^.+$ rather than ^ so that the homepage, whose path is empty here, can never
# match. Real files are excluded, so css, js and photos are untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^.+$ /404.php [L]

# ---------------------------------------------------------------------------
# Everything below is Apache only. OpenLiteSpeed ignores it.
# ---------------------------------------------------------------------------

# Apache's own error page setting. Harmless duplication of the rewrite above:
# whichever the server supports, the visitor gets the site's 404 page.
ErrorDocument 404 /404.php

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.php
  # Without this, mod_dir would 301 /services to /services/ and change an
  # address that is in the sitemap and in Google's index.
  DirectorySlash Off
</IfModule>

# The shared includes are pulled in by the page files and are never a page of
# their own. Each one also refuses a direct request in PHP, so this block is a
# second lock rather than the only one.
#
# Both spellings are wrapped, so a server with neither module does nothing here
# rather than failing every page with a 500.
<FilesMatch "^(header|footer|header-include|icons|router)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
